# Database - local SQLite file, or Turso "libsql://<db>-<org>.turso.io" in Vercel
DATABASE_URL="file:bali-food.db"
# Optional locally, required for Turso in Vercel
DATABASE_AUTH_TOKEN=""

# Gemini API key (Google AI Studio)
GEMINI_API_KEY=""

# Google OAuth (scopes used: openid email profile ONLY)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Email of the first parent admin - auto-seeded on first Google login
INITIAL_PARENT_EMAIL=""

# Local development only: shows a user-switcher bar (Parent + 3 demo children)
# so the app can be tested before Google OAuth is configured.
# NEVER set this to "true" in Vercel production.
DEV_BYPASS_AUTH="true"
